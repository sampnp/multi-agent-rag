# ── Application ────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values before running.
# Never commit .env to version control.

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Databases ──────────────────────────────────────────────────────────────────
POSTGRES_USER=aiplatform
POSTGRES_PASSWORD=aiplatform
POSTGRES_DB=aiplatform
# Used directly by the backend (override for Docker — points to postgres container)
POSTGRES_URL=postgresql+asyncpg://aiplatform:aiplatform@localhost:5432/aiplatform

REDIS_URL=redis://localhost:6379

QDRANT_HOST=localhost
QDRANT_PORT=6333

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aiplatform123

ELASTICSEARCH_URL=http://localhost:9200

# ── AI / LLM ───────────────────────────────────────────────────────────────────
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# Whisper model size: tiny | base | small | medium | large
# Larger = more accurate but slower. 'base' is a good balance.
WHISPER_MODEL=base

# ── Integrations (all optional) ────────────────────────────────────────────────
# Jira — leave blank to use simulated issue creation
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ

# ── Observability (all optional — features degrade gracefully if unset) ────────
# LangSmith tracing (https://smith.langchain.com)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-ai-os

# OpenTelemetry OTLP endpoint (e.g. Jaeger: http://localhost:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Set to false to disable the /metrics Prometheus endpoint
PROMETHEUS_ENABLED=true

# ── Frontend build-time vars (Vite) ────────────────────────────────────────────
# Leave empty when running behind nginx (Docker). Set to your Railway URL for Vercel deploys.
VITE_API_URL=
VITE_WS_URL=
